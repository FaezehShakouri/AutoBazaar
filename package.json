{
  "name": "vending-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/vendor.mjs",
    "test": "node --test tests/*.test.mjs",
    "simulate": "node scripts/simulate.mjs",
    "check": "node --check dist/game-app.js && node --check dist/world.js && node --check dist/playback.js && node --check dist/engine.js && node --check dist/sales-model.js && node --check server.mjs && node --check lib/codex.mjs && node --check lib/codex-binary.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@worldcoin/agentkit": "0.2.1",
    "@worldcoin/idkit-core": "4.2.4",
    "qrcode": "1.5.4",
    "three": "0.186.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.131.1"
  }
}
