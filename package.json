{
  "name": "vending-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/vendor.mjs",
    "test": "node --test tests/*.test.mjs",
    "simulate": "node scripts/simulate.mjs",
    "agent": "node --env-file-if-exists=.agent.env scripts/remote-agent.mjs",
    "agent:wallet": "node scripts/create-agent-wallet.mjs",
    "cloud:dev": "wrangler dev",
    "cloud:check": "wrangler deploy --dry-run --outdir .worker-build",
    "cloud:deploy": "wrangler deploy",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@worldcoin/agentkit": "0.2.1",
    "@worldcoin/idkit-core": "4.2.4",
    "qrcode": "1.5.4",
    "three": "0.186.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.131.1"
  }
}
