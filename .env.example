# Node server. A local practice game and shared seasons are both available.
PORT=3000
BIND_ADDRESS=127.0.0.1
# For a Node server behind HTTPS, set both BIND_ADDRESS=0.0.0.0 and PUBLIC_ORIGIN.
# PUBLIC_ORIGIN=https://your-game.example
# SEASON_DB=/persistent-data/seasons.sqlite
SEASON_TURN_SECONDS=180
SEASON_INTERMISSION_SECONDS=30
AGENTBOOK_ENVIRONMENT=production
# Optional dedicated World Chain RPC; credentials stay on the server.
# WORLDCHAIN_RPC_URL=https://...
SEASON_IDENTITY_MODE=agentbook
# Optional isolated World ID Sandbox diagnostics at /world-id-diagnostic.
# Diagnostics do not register wallets or grant game entry.
# WORLD_ID_APP_ID=app_...
# WORLD_ID_RP_ID=rp_...
# WORLD_ID_ACTION=autobazaar-agent-test
# WORLD_ID_SANDBOX_CREDENTIAL=proof_of_human
# WORLD_ID_SIGNING_KEY=...
# One-time retirement of an empty legacy app registry; never funded seasons.
# MIGRATE_EMPTY_SANDBOX_TO_AGENTBOOK=true
# Custom AgentBook deployment (a different integration from IDKit Sandbox):
# use a separate escrow/database and sponsor-provided deployment details.
# AGENTBOOK_ENVIRONMENT=sandbox
# AGENTBOOK_CHAIN_ID=...
# AGENTBOOK_ADDRESS=0x...
# WORLDCHAIN_RPC_URL=https://...

# Arc Testnet (optional on a local server; required for funded seasons).
# npm run arc:setup creates .arc.env privately; npm start loads it.
# ARC_CONTRACT_ADDRESS=0x...
# ARC_OPERATOR_PRIVATE_KEY=0x...  (server secret; never the player key)
# ARC_RPC_URL=https://rpc.testnet.arc.io
# ARC_MAX_GAS_USDC=0.50

# Hackathon demo: one verified entrant + three explicit house wallets.
# Default competition mode still requires four verified humans.
# SEASON_MODE=demo
# DEMO_AGENT_ADDRESSES=0xHOUSE1,0xHOUSE2,0xHOUSE3
# ALLOW_EMPTY_DEMO_MIGRATION=true
# Convert only a sole waiting human entrant, preserving its verified deposit.
# ALLOW_SINGLE_HUMAN_DEMO_MIGRATION=true
